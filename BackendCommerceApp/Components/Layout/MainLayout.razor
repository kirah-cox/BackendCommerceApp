@inherits LayoutComponentBase
@implements IDisposable
@using BackendCommerceApp.Services
@inject AuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="top-search">
                <input class="form-control" type="search" placeholder="Search products" aria-label="Search products" />
            </div>

            <div class="auth-buttons">
                @if (AuthService.CurrentUser is { } currentUser)
                {
                    <span class="auth-greeting">Hello @currentUser.FirstName!</span>
                }
                else
                {
                    <a class="btn btn-outline-primary" href="login">Log in</a>
                    <a class="btn btn-primary" href="signup">Sign up</a>
                }

                <button class="cart-button" type="button" aria-label="Shopping cart" title="Shopping cart">
                    <span aria-hidden="true">🛒</span>
                </button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.CurrentUserChanged += HandleCurrentUserChanged;
    }

    private void HandleCurrentUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.CurrentUserChanged -= HandleCurrentUserChanged;
    }
}
