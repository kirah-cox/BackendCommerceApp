@implements IDisposable
@using BackendCommerceApp.Services
@inject CartService CartService
@inject NavigationManager NavigationManager

@if (IsOpen)
{
    <div class="cart-backdrop" @onclick="OnClose"></div>
    <div class="cart-drawer">
        <div class="cart-drawer-header">
            <h2>Shopping Cart (@CartService.TotalItems)</h2>
            <button class="cart-close-btn" type="button" @onclick="OnClose" aria-label="Close cart">&times;</button>
        </div>

        <div class="cart-drawer-body">
            @if (!CartService.Items.Any())
            {
                <div class="cart-drawer-empty">
                    <div class="empty-icon" aria-hidden="true">🛒</div>
                    <p>Your cart is empty.</p>
                </div>
            }
            else
            {
                <div class="cart-drawer-items">
                    @foreach (var item in CartService.Items)
                    {
                        <div class="cart-drawer-item">
                            <div class="item-info">
                                <a href="@($"/product/{item.Product.Id}")" class="item-name" @onclick="OnClose">@item.Product.Name</a>
                                <div class="item-unit-price">$@item.Product.Price.ToString("0.00")</div>
                            </div>
                            <div class="item-qty-controls">
                                <button class="qty-btn" type="button" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                <span class="qty-value">@item.Quantity</span>
                                <button class="qty-btn" type="button" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity + 1)">+</button>
                            </div>
                            <span class="item-total">$@item.TotalPrice.ToString("0.00")</span>
                            <button class="item-remove-btn" type="button" @onclick="() => CartService.RemoveFromCart(item.Product.Id)" title="Remove item" aria-label="Remove item">&times;</button>
                        </div>
                    }
                </div>
            }
        </div>

        @if (CartService.Items.Any())
        {
            <div class="cart-drawer-footer">
                <div class="cart-subtotal">
                    <span>Subtotal</span>
                    <span class="subtotal-amount">$@CartService.Subtotal.ToString("0.00")</span>
                </div>
                <div class="cart-drawer-actions">
                    <a href="cart" class="btn btn-outline-primary" @onclick="OnClose">View Cart</a>
                    <a href="checkout" class="btn btn-primary" @onclick="OnClose">Checkout</a>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    protected override void OnInitialized()
    {
        CartService.CartChanged += HandleCartChanged;
    }

    private void HandleCartChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnClose()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    public void Dispose()
    {
        CartService.CartChanged -= HandleCartChanged;
    }
}
