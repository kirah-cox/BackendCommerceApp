@page "/"
@using BackendCommerceApp.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<PageTitle>Home</PageTitle>

<section class="hero">
    <h1>Welcome to Our Store</h1>
    <p>Shop the latest products across all your favorite categories.</p>
</section>

<section class="categories">
    <h2>Shop by Category</h2>
    <div class="category-grid">
        @foreach (var category in ProductCatalog.Categories)
        {
            <a class="category-card" href="@($"/category/{category.Slug}")">
                <div class="category-icon">@category.Icon</div>
                <div class="category-name">@category.Name</div>
                <div class="category-count">@(productCounts.GetValueOrDefault(category.Slug)) items</div>
            </a>
        }
    </div>
</section>

@code {
    private Dictionary<string, int> productCounts = new();

    protected override async Task OnInitializedAsync()
    {
        productCounts = await DbContext.Products
            .GroupBy(product => product.Category)
            .Select(group => new { Category = group.Key, Count = group.Count() })
            .ToDictionaryAsync(group => group.Category, group => group.Count);
    }
}

