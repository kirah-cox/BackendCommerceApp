@page "/"
@using BackendCommerceApp.Data

<PageTitle>Home</PageTitle>

<section class="hero">
    <h1>Welcome to Our Store</h1>
    <p>Shop the latest products across all your favorite categories.</p>
</section>

<section class="categories">
    <h2>Shop by Category</h2>
    <div class="category-grid">
        @foreach (var category in ProductCatalog.Categories)
        {
            <a class="category-card" href="@($"/category/{category.Slug}")">
                <div class="category-icon">@category.Icon</div>
                <div class="category-name">@category.Name</div>
                <div class="category-count">@ProductCatalog.ProductCountForCategory(category.Slug) items</div>
            </a>
        }
    </div>
</section>

<section class="featured">
    <h2>Featured Products</h2>
    <div class="product-grid">
        @foreach (var product in FeaturedProducts)
        {
            <a class="product-card" href="@($"/product/{product.Id}")">
                <div class="product-image">@product.Icon</div>
                <div class="product-name">@product.Name</div>
                <div class="product-category">@ProductCatalog.GetCategory(product.CategorySlug)?.Name</div>
                <div class="product-price">@product.Price.ToString("C")</div>
            </a>
        }
    </div>
</section>

@code {
    private List<CatalogProduct> FeaturedProducts { get; } = ProductCatalog.Products.Take(4).ToList();
}
