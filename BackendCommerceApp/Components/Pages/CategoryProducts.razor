@page "/category/{Slug}"
@using BackendCommerceApp.Data

<PageTitle>@(category?.Name ?? "Category not found")</PageTitle>

@if (category is null)
{
    <p>Category not found. <a href="/">Go back home</a>.</p>
}
else
{
    <section class="category-header">
        <div class="category-header-icon">@category.Icon</div>
        <div>
            <h1>@category.Name</h1>
            <p>@products.Count item(s) in this category</p>
        </div>
    </section>

    <div class="product-grid">
        @foreach (var product in products)
        {
            <a class="product-card" href="@($"/product/{product.Id}")">
                <div class="product-image">@product.Icon</div>
                <div class="product-name">@product.Name</div>
                <div class="product-price">@product.Price.ToString("C")</div>
            </a>
        }
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private CatalogCategory? category;
    private List<CatalogProduct> products = new();

    protected override void OnParametersSet()
    {
        category = ProductCatalog.GetCategory(Slug);
        products = ProductCatalog.Products.Where(p => p.CategorySlug == Slug).ToList();
    }
}
