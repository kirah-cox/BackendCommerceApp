@page "/category/{Slug}"
@using BackendCommerceApp.Data
@using BackendCommerceApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<PageTitle>@(category?.Name ?? "Category not found")</PageTitle>

@if (category is null)
{
    <p>Category not found. <a href="/">Go back home</a>.</p>
}
else
{
    <section class="category-header">
        <div class="category-header-icon category-icon-@category.Slug" aria-hidden="true"></div>
        <div>
            <h1>@category.Name</h1>
            <p>@products.Count item(s) in this category</p>
        </div>
    </section>

    <div class="product-grid">
        @foreach (var product in products)
        {
            <a class="product-card" href="@($"/product/{product.Id}")">
                <div class="product-image" aria-hidden="true">🛍️</div>
                <div class="product-name">@product.Name</div>
                <div class="product-price">$@product.Price.ToString("0.00")</div>
            </a>
        }
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private CatalogCategory? category;
    private List<Product> products = new();

    protected override async Task OnParametersSetAsync()
    {
        category = ProductCatalog.GetCategory(Slug);
        products = category is null
            ? new List<Product>()
            : await DbContext.Products.Where(product => product.Category == Slug).ToListAsync();
    }
}
